# the gir generated by valac, fixed for the bindings
python = find_program('python3')
pamac_gir = custom_target('pamac gir',
	command: [python, files('fix_gir.py'), join_paths(meson.current_build_dir(), '..', 'Pamac-12.gir'), '@OUTPUT@'],
	output: 'Pamac-12.gir',
	depends: libpamac,
	install: true,
	install_dir: join_paths(get_option('datadir'), 'gir-1.0'))

# create typelib files
g_ir_compiler = find_program('g-ir-compiler')
custom_target('pamac typelib', command: [g_ir_compiler, '--shared-library', 'libpamac', '--output', '@OUTPUT@', '@INPUT@'],
	input: pamac_gir,
	output: 'Pamac-12.typelib',
	install: true,
	install_dir: join_paths(get_option('libdir'), 'girepository-1.0'))
